main = fn(args) {
	// weave_spec.md §15.2: every Go function/method call always returns
	// a Weave list now, regardless of how many values the real Go call
	// returns — at(list, i) reads one position back out.
	//
	// weave_spec.md §15.1/§15.2: gofunc(...)/gomethod(...) declarations
	// are always reflect-dispatched now (weavert.CallGoFuncList/
	// CallGoMethodList) — the only thing that can be declared ahead of
	// time is, optionally, a second "proto" argument binding position 0
	// of the returned list to an earlier gotype(...), so a later
	// `.Method()` call on the extracted value still resolves at compile
	// time (checkGoMethodCall) instead of falling back to dynamic
	// prototype-chain search. len below has no proto of its own (its
	// return value is just a plain number).
	GoReader = gotype("?*strings.Reader", {
		len: gomethod("Len"),
		readByte: gomethod("ReadByte")
	})
	newReader = gofunc("?strings.NewReader", GoReader)

	result = newReader("hello, weave")
	r = at(result, 0)

	print(at(r.len(), 0))
	print(at(r.len(), 0) + 8)
	print(at(r.len(), 0) > 10)

	readByteResult = r.readByte()
	raiseIfError(at(readByteResult, 1))
	print(at(readByteResult, 0))

	// bytes.NewReader(b []byte) *bytes.Reader — CallGoFuncList's own
	// reflect.Value.Convert already turns a Weave string into []byte for
	// the real call (Go itself treats string<->[]byte as a defined
	// conversion, and reflect.Convert follows the same rule) — no
	// special declaration needed on the Weave side for this direction.
	GoBytesReader = gotype("?*bytes.Reader", { len: gomethod("Len") })
	newBytesReader = gofunc("?bytes.NewReader", GoBytesReader)
	bytesResult = newBytesReader("raw bytes")
	br = at(bytesResult, 0)
	print(at(br.len(), 0))

	return at(r.len(), 0)
}
