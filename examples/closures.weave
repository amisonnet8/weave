main = fn(args) {
	add = fn(a) fn(b) { return a + b }
	add5 = add(5)
	result = add5(3)
	result2 = add(5)(3)
	result3 = add(5, 3)
	print(result)
	print(result2)
	print(result3)

	add3 = fn(a) fn(b) fn(c) { return a + b + c }
	print(add3(1)(2)(3))
	print(add3(1, 2, 3))

	base = 100
	addBase = fn(x) { return x + base }
	print(addBase(5))

	n = 1
	getN = fn(unused) { return n }
	n = 2
	print(getN(nil))

	// Reference capture (weave_spec.md §10) also means a closure can
	// accumulate state across multiple calls to the same instance: each
	// call mutates the same captured `count`, not a fresh copy.
	makeCounter = fn(start) {
		count = start
		return fn(step) {
			count = count + step
			return count
		}
	}
	counter = makeCounter(0)
	print(counter(1))
	print(counter(1))
	print(counter(5))

	return result3
}
