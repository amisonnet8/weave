main = fn(args) {
	// weave_spec.md §15.3 shows gotype/gofunc declared at true top
	// level (module scope), but Weave's grammar only supports general
	// top-level statements once Step 5 (functions) and Step 6 (objects)
	// existed to produce them — general top-level bindings are still
	// not implemented as of this step, so declarations live inside
	// main() for now (see CLAUDE.md's 後半 Step 3 "確定した設計判断").
	//
	// weave_spec.md §15.2: every gofunc(...)/gomethod(...) call always
	// returns a Weave list now, regardless of how many values the real
	// Go function returns — at(list, i) reads one position back out.
	toUpper = gofunc("?strings.ToUpper")
	trimSpace = gofunc("?strings.TrimSpace")

	print(at(toUpper("hello, weave"), 0))
	print(at(trimSpace("  padded  "), 0))

	// os.ReadFile(name string) ([]byte, error) — a real Go stdlib
	// function returning Go's common (value, error) shape. Untyped here
	// (no goReturns(...)): weavert.CallGoFuncList collects every actual
	// return value into the list via reflection, normalizing []byte into
	// a plain Weave string (weavert/goasset.go). No automatic error
	// panic any more — raiseIfError(...) does that explicitly.
	readFile = gofunc("?os.ReadFile")
	fileResult = readFile("examples/testdata.txt")
	raiseIfError(at(fileResult, 1))
	print(at(fileResult, 0))

	// strconv.Atoi(s string) (int, error) — another (value, error) stdlib
	// function, this time with a typed signature declared via
	// goReturns(...)/goParams(...) (weave_spec.md §15.4). Unlike readFile
	// above, this lowers to a fully native 2-target CALL
	// (internal/codegen/goasset.go's genGoFuncCall) — ASSERT the
	// argument, CALL raw+err directly against ?strconv.Atoi, box both
	// into a 2-element list. No reflect anywhere in this call.
	// (os.ReadFile's own []byte return can't take this typed path — AMIVM's
	// `type1` operand category has no slice-literal form like `^[]byte`,
	// only named types via a prior SLTYPE — so it stays on the untyped
	// path above.)
	atoi = gofunc("?strconv.Atoi", goReturns("?int", "?error"), goParams("?string"))
	atoiResult = atoi("42")
	raiseIfError(at(atoiResult, 1))
	print(at(atoiResult, 0) + 1)

	return 0
}
