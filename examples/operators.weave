main = fn(args) {
	print(1 + 2 * 3)
	print((1 + 2) * 3)
	print(10 - 3 - 2)
	print(2 * 3 == 6 && 1 < 2)
	print(true || false && false)
	print(!true)
	print(-5 + 10)
	print("foo" + "bar")
	print(10 % 3)
	print(1 == 1.0)
	print(1 == "1")
	print("abc" < "abd")

	// weave_spec.md §8: numbers are always float64, so `%` is a
	// floating-point remainder (not integer-only), and division by zero
	// follows IEEE754 rather than erroring.
	print(5.5 % 2)
	print(1 / 0)
	print(-1 / 0)
	print(0 / 0)

	x = 1 + 2
	y = x * 10
	return y
}
