// weave_spec.md §4.3: shape(...)/checkShape(...) are Weave's own
// equivalent of TypeScript/Python type hints — optional, checked only
// where you call checkShape, and about catching mistakes early with a
// clear message rather than making anything faster.
main = fn(args) {
	PointShape = shape({ x: "number", y: "number" })

	origin = { x: 0, y: 0 }
	checkShape(PointShape, origin)
	print("origin matches PointShape")

	WidgetShape = shape({
		label: "string",
		visible: "bool",
		onClick: "function",
		position: "object"
	})
	widget = {
		label: "OK button",
		visible: true,
		onClick: fn(event) { return event },
		position: { x: 10, y: 20 }
	}
	checkShape(WidgetShape, widget)
	print("widget matches WidgetShape")

	return 0
}
